{
    // Thin wrappers over mani tasks (see mani.yaml), the single source of truth, also used by Claude via CLAUDE.md.
    "version": "2.0.0",
    "options": { "cwd": "${workspaceFolder}" },
    "tasks": [
        {
            "label": "Launch Jupyter",
            "type": "shell",
            "command": "jupyter notebook --notebook-dir tmp",
            "problemMatcher": []
        },
        {
            "label": "Clone all repos",
            "type": "shell",
            "command": "mani sync && mani run submodules --all",
            "problemMatcher": []
        },
        {
            "label": "Update default branch in a clone",
            "type": "shell",
            "command": "mani run update-default -p ${input:repo_name}",
            "problemMatcher": []
        },
        {
            "label": "Update default branch in all clones",
            "type": "shell",
            "command": "mani run update-default --all",
            "problemMatcher": []
        },
        {
            "label": "Add remote to a clone",
            "type": "shell",
            "command": "mani run add-remote -p ${input:repo_name} REMOTE=${input:remote_name}",
            "problemMatcher": []
        },
        {
            "label": "Build Cmake",
            "type": "shell",
            "command": "mani run build-cmake -p ${input:repo_name}",
            "problemMatcher": []
        }
    ],
    "inputs": [
        { "id": "repo_name", "description": "", "default": "MaterialX", "type": "promptString" },
        { "id": "remote_name", "description": "", "default": "MustafaJafar", "type": "promptString" }
    ]
}
